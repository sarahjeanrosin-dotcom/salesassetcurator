# ── AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Web Search ────────────────────────────────────────────────────
SERPER_API_KEY=

# ── YouTube ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Social APIs ───────────────────────────────────────────────────
# Twitter/X — bearer token from developer.twitter.com
TWITTER_BEARER_TOKEN=

# LinkedIn — client credentials from developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Instagram / Facebook (Meta Graph API)
META_ACCESS_TOKEN=

# Reddit — from reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=salesassetcurator/0.1.0

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesassetcurator

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
